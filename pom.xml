<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.mydog</groupId>
  <artifactId>mydog</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>MyDog</name>
  <description>Cross-platform MySQL desktop management tool with database-to-database sync</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <javafx.version>27.0.1</javafx.version>
    <main.class>com.mydog.MyDogApp</main.class>
    <!-- JavaFX prism pipeline: es2 (OpenGL) for manual dev runs; override to sw
         (-Dmydog.prism.order=sw) for automated headless-ish smoke tests so no GPU
         work is generated next to the flaky AMD driver on this dev machine. -->
    <mydog.prism.order>es2</mydog.prism.order>
    <!-- tests that touch the toolkit use software rendering: no GPU on CI, and none of the
         flaky-driver exposure this dev machine has -->
    <mydog.test.prism.order>sw</mydog.test.prism.order>
    <!-- the jpackage app-version must be one to three dot-separated integers AND the
         major must be positive (verified with jpackage 25.0.2: both "0.1.0-SNAPSHOT"
         and "0.1.0" are rejected). The 0.x project line therefore maps to installer
         version 1.0.0; bump this in lockstep with <version> when cutting a release. -->
    <jpackage.app.version>1.0.0</jpackage.app.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.14.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- JavaFX: openjfx POM activates OS profile automatically (no classifier needed) -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- Code editor control (0.11.7 is required for JavaFX 25+) -->
    <dependency>
      <groupId>org.fxmisc.richtext</groupId>
      <artifactId>richtextfx</artifactId>
      <version>0.11.7</version>
      <exclusions>
        <exclusion>
          <groupId>org.openjfx</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>26.10.0</version>
    </dependency>

    <!-- Theme -->
    <dependency>
      <groupId>io.github.mkpaz</groupId>
      <artifactId>atlantafx-base</artifactId>
      <version>3.0.0</version>
      <exclusions>
        <exclusion>
          <groupId>org.openjfx</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.20</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.20</version>
    </dependency>

    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.15.0</version>
    </dependency>

    <!-- test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <excludedGroups>docker</excludedGroups>
          <argLine>-Dprism.order=${mydog.test.prism.order}</argLine>
        </configuration>
      </plugin>

      <!-- src/it/java must be added to the test source root, otherwise nothing compiles
           it (failsafe only *selects* classes, it never compiles a separate source dir) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.8.0</version>
        <executions>
          <execution>
            <id>add-it-sources</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src/it/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- integration tests in src/it, tagged "docker", run on verify -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- IT classes share target/test-classes with unit tests; the "docker" group
               tag is what separates them (surefire excludes it, failsafe includes it) -->
          <groups>docker</groups>
          <!-- the wizard model IT starts the real toolkit; keep it off the GPU on a dev
               machine and off a missing GPU on a CI runner -->
          <argLine>-Dprism.order=${mydog.test.prism.order}</argLine>
        </configuration>
      </plugin>

      <!-- dev-time run: ./mvnw javafx:run -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
          <options>
            <option>--enable-native-access=javafx.graphics</option>
            <option>-Dfile.encoding=UTF-8</option>
            <!-- AMD Metal driver crash workaround on this dev machine: default OpenGL (es2),
                 override with -Dmydog.prism.order=sw for automated smoke tests -->
            <option>-Dprism.order=${mydog.prism.order}</option>
            <option>-Dprism.verbose=false</option>
          </options>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- ========================================================================
         Native installers via jpackage (M5). v1 deliberately uses the NON-MODULAR
         classpath route: copy every runtime dependency plus the app jar into
         target/app, then hand that directory to jpackage, which bundles a full
         JDK runtime (no jlink trimming, no ModiTect module-info) — installers land
         around ~300 MB, which is accepted for v1. Modularization is a v2 item.

         Run the profile matching the machine's OS; jpackage cannot cross-build:
           macOS   : ./mvnw -P native-mac   verify   ->  target/dist/*.dmg
           Windows : mvnw.cmd -P native-win verify   ->  target/dist/*.msi
           Linux   : ./mvnw -P native-linux verify   ->  target/dist/*.deb
         The openjfx dependency carries no OS classifier in <dependencies> on
         purpose: its POM activates the matching platform profile, so each
         installer embeds exactly its own platform's JavaFX jars.
         Unsigned macOS build: first launch needs right-click -> Open. Signing /
         notarization are optional later steps (see README).
         ======================================================================== -->

    <!-- Shared plugin block for the three profiles; only the jpackage type and
         platform-specific flags differ. -->
    <profile>
      <id>native-mac</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <version>3.4.1</version>
            <executions>
              <execution>
                <!-- jpackage refuses to overwrite an existing installer; wipe
                     target/dist before each packaging run so `verify` is re-runnable -->
                <id>clean-dist</id>
                <phase>prepare-package</phase>
                <goals><goal>clean</goal></goals>
                <configuration>
                  <excludeDefaultDirectories>true</excludeDefaultDirectories>
                  <filesets>
                    <fileset><directory>${project.build.directory}/dist</directory></fileset>
                  </filesets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.11.0</version>
            <executions>
              <execution>
                <id>copy-deps</id>
                <phase>prepare-package</phase>
                <goals><goal>copy-dependencies</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/app</outputDirectory>
                  <includeScope>runtime</includeScope>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <!-- jpackage reads main-jar relative to its input dir, so the app jar must
                     sit next to the copied dependencies. Declared in the same phase as
                     jar:jar but after it (lifecycle-bound goals run first), so the jar
                     exists by the time this copies it. -->
                <id>copy-app-jar</id>
                <phase>package</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/app</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.directory}</directory>
                      <includes><include>${project.build.finalName}.jar</include></includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.7.0</version>
            <executions>
              <execution>
                <id>jpackage-mac</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/jpackage</executable>
                  <arguments>
                    <argument>--type</argument><argument>dmg</argument>
                    <argument>--name</argument><argument>MyDog</argument>
                    <argument>--input</argument><argument>${project.build.directory}/app</argument>
                    <argument>--main-jar</argument><argument>${project.build.finalName}.jar</argument>
                    <argument>--main-class</argument><argument>${main.class}</argument>
                    <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                    <argument>--app-version</argument><argument>${jpackage.app.version}</argument>
                    <argument>--vendor</argument><argument>MyDog Contributors</argument>
                    <argument>--description</argument><argument>${project.description}</argument>
                    <argument>--icon</argument><argument>${project.basedir}/src/main/packaging/mydog.icns</argument>
                    <argument>--java-options</argument><argument>-Dfile.encoding=UTF-8</argument>
                    <!-- JavaFX from the classpath: the JDK launcher refuses to start an
                         Application subclass unless javafx.graphics is resolved as a module
                         ("JavaFX runtime components are missing" — observed with the plain
                         classpath cfg). openjfx's -<os> classifier jars are complete modules
                         (module-info + native libs), so point the module path at the app
                         directory and resolve controls; the native-access flag silences the
                         System::load warning exactly like the javafx:run dev config. -->
                    <argument>--java-options</argument><argument>--module-path=$APPDIR</argument>
                    <argument>--java-options</argument><argument>--add-modules=javafx.controls</argument>
                    <argument>--java-options</argument><argument>--enable-native-access=javafx.graphics</argument>
                    <argument>--mac-package-name</argument><argument>MyDog</argument>
                    <argument>--mac-package-identifier</argument><argument>com.mydog.app</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>native-win</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>

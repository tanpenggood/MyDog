                <configuration>
                  <excludeDefaultDirectories>true</excludeDefaultDirectories>
                  <filesets>
                    <fileset><directory>${project.build.directory}/dist</directory></fileset>
                  </filesets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.11.0</version>
            <executions>
              <execution>
                <id>copy-deps</id>
                <phase>prepare-package</phase>
                <goals><goal>copy-dependencies</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/app</outputDirectory>
                  <includeScope>runtime</includeScope>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>copy-app-jar</id>
                <phase>package</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/app</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.directory}</directory>
                      <includes><include>${project.build.finalName}.jar</include></includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.7.0</version>
            <executions>
              <execution>
                <id>jpackage-win</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/jpackage</executable>
                  <arguments>
                    <argument>--type</argument><argument>msi</argument>
                    <argument>--name</argument><argument>MyDog</argument>
                    <argument>--input</argument><argument>${project.build.directory}/app</argument>
                    <argument>--main-jar</argument><argument>${project.build.finalName}.jar</argument>
                    <argument>--main-class</argument><argument>${main.class}</argument>
                    <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                    <argument>--app-version</argument><argument>${jpackage.app.version}</argument>
                    <argument>--vendor</argument><argument>MyDog Contributors</argument>
                    <argument>--description</argument><argument>${project.description}</argument>
                    <argument>--icon</argument><argument>${project.basedir}/src/main/packaging/mydog.ico</argument>
                    <argument>--java-options</argument><argument>-Dfile.encoding=UTF-8</argument>
                    <!-- JavaFX from the classpath: the JDK launcher refuses to start an
                         Application subclass unless javafx.graphics is resolved as a module
                         ("JavaFX runtime components are missing" — observed with the plain
                         classpath cfg). openjfx's -<os> classifier jars are complete modules
                         (module-info + native libs), so point the module path at the app
                         directory and resolve controls; the native-access flag silences the
                         System::load warning exactly like the javafx:run dev config. -->
                    <argument>--java-options</argument><argument>--module-path=$APPDIR</argument>
                    <argument>--java-options</argument><argument>--add-modules=javafx.controls</argument>
                    <argument>--java-options</argument><argument>--enable-native-access=javafx.graphics</argument>
                    <!-- fixed upgrade UUID: same value across releases lets the msi
                         upgrade in place instead of side-installing; never change it -->
                    <argument>--win-upgrade-uuid</argument><argument>3f2b7a91-5c48-4f6e-9d2a-1b8c7e4f0a55</argument>
                    <argument>--win-menu</argument>
                    <argument>--win-shortcut</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>native-linux</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <version>3.4.1</version>
            <executions>
              <execution>
                <id>clean-dist</id>
                <phase>prepare-package</phase>
                <goals><goal>clean</goal></goals>
                <configuration>
                  <excludeDefaultDirectories>true</excludeDefaultDirectories>
                  <filesets>
                    <fileset><directory>${project.build.directory}/dist</directory></fileset>
                  </filesets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.11.0</version>
            <executions>
              <execution>
                <id>copy-deps</id>
                <phase>prepare-package</phase>
                <goals><goal>copy-dependencies</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/app</outputDirectory>
                  <includeScope>runtime</includeScope>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>copy-app-jar</id>
                <phase>package</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/app</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.directory}</directory>
                      <includes><include>${project.build.finalName}.jar</include></includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.7.0</version>
            <executions>
              <execution>
                <id>jpackage-linux</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/jpackage</executable>
                  <arguments>
                    <argument>--type</argument><argument>deb</argument>
                    <argument>--name</argument><argument>MyDog</argument>
                    <argument>--input</argument><argument>${project.build.directory}/app</argument>
                    <argument>--main-jar</argument><argument>${project.build.finalName}.jar</argument>
                    <argument>--main-class</argument><argument>${main.class}</argument>
                    <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                    <argument>--app-version</argument><argument>${jpackage.app.version}</argument>
                    <argument>--vendor</argument><argument>MyDog Contributors</argument>
                    <argument>--description</argument><argument>${project.description}</argument>
                    <argument>--icon</argument><argument>${project.basedir}/src/main/packaging/mydog_512.png</argument>
                    <argument>--java-options</argument><argument>-Dfile.encoding=UTF-8</argument>
                    <!-- JavaFX from the classpath: the JDK launcher refuses to start an
                         Application subclass unless javafx.graphics is resolved as a module
                         ("JavaFX runtime components are missing" — observed with the plain
                         classpath cfg). openjfx's -<os> classifier jars are complete modules
                         (module-info + native libs), so point the module path at the app
                         directory and resolve controls; the native-access flag silences the
                         System::load warning exactly like the javafx:run dev config. -->
                    <argument>--java-options</argument><argument>--module-path=$APPDIR</argument>
                    <argument>--java-options</argument><argument>--add-modules=javafx.controls</argument>
                    <argument>--java-options</argument><argument>--enable-native-access=javafx.graphics</argument>
                    <argument>--linux-deb-maintainer</argument><argument>MyDog Contributors &lt;maintainers@mydog.invalid&gt;</argument>
                    <argument>--linux-menu-group</argument><argument>Utility</argument>
                    <argument>--linux-shortcut</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.mydog</groupId>
  <artifactId>mydog</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>MyDog</name>
  <description>Cross-platform MySQL desktop management tool with database-to-database sync</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <javafx.version>27.0.1</javafx.version>
    <main.class>com.mydog.MyDogApp</main.class>
    <!-- JavaFX prism pipeline: es2 (OpenGL) for manual dev runs; override to sw
         (-Dmydog.prism.order=sw) for automated headless-ish smoke tests so no GPU
         work is generated next to the flaky AMD driver on this dev machine. -->
    <mydog.prism.order>es2</mydog.prism.order>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.14.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- JavaFX: openjfx POM activates OS profile automatically (no classifier needed) -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- Code editor control (0.11.7 is required for JavaFX 25+) -->
    <dependency>
      <groupId>org.fxmisc.richtext</groupId>
      <artifactId>richtextfx</artifactId>
      <version>0.11.7</version>
      <exclusions>
        <exclusion>
          <groupId>org.openjfx</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>26.10.0</version>
    </dependency>

    <!-- Theme -->
    <dependency>
      <groupId>io.github.mkpaz</groupId>
      <artifactId>atlantafx-base</artifactId>
      <version>3.0.0</version>
      <exclusions>
        <exclusion>
          <groupId>org.openjfx</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.20</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.20</version>
    </dependency>

    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.15.0</version>
    </dependency>

    <!-- test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <excludedGroups>docker</excludedGroups>
        </configuration>
      </plugin>

      <!-- src/it/java must be added to the test source root, otherwise nothing compiles
           it (failsafe only *selects* classes, it never compiles a separate source dir) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.8.0</version>
        <executions>
          <execution>
            <id>add-it-sources</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src/it/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- integration tests in src/it, tagged "docker", run on verify -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- IT classes share target/test-classes with unit tests; the "docker" group
               tag is what separates them (surefire excludes it, failsafe includes it) -->
          <groups>docker</groups>
        </configuration>
      </plugin>

      <!-- dev-time run: ./mvnw javafx:run -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
          <options>
            <option>--enable-native-access=javafx.graphics</option>
            <option>-Dfile.encoding=UTF-8</option>
            <!-- AMD Metal driver crash workaround on this dev machine: default OpenGL (es2),
                 override with -Dmydog.prism.order=sw for automated smoke tests -->
            <option>-Dprism.order=${mydog.prism.order}</option>
            <option>-Dprism.verbose=false</option>
          </options>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- native packaging (M5): mvn -P native-mac package -->
    <profile>
      <id>native-mac</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.11.0</version>
            <executions>
              <execution>
                <id>copy-deps</id>
                <phase>prepare-package</phase>
                <goals><goal>copy-dependencies</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/app</outputDirectory>
                  <includeScope>runtime</includeScope>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.7.0</version>
            <executions>
              <execution>
                <id>jpackage-mac</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/jpackage</executable>
                  <arguments>
                    <argument>--type</argument><argument>dmg</argument>
                    <argument>--name</argument><argument>MyDog</argument>
                    <argument>--input</argument><argument>${project.build.directory}/app</argument>
                    <argument>--main-jar</argument><argument>${project.build.finalName}.jar</argument>
                    <argument>--main-class</argument><argument>${main.class}</argument>
                    <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                    <argument>--app-version</argument><argument>${project.version}</argument>
                    <argument>--java-options</argument><argument>-Dfile.encoding=UTF-8</argument>
                    <argument>--mac-package-name</argument><argument>MyDog</argument>
                    <argument>--mac-package-identifier</argument><argument>com.mydog.app</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
